{
  "schemaVersion": "1.0.0",
  "brand": "AtlasHub.SI",
  "status": "approved-visual-direction; engineering-pending",
  "foundations": {
    "palette": {
      "background": "#040C18",
      "surface": "#061321",
      "surfaceElevated": "#09192D",
      "surfaceHover": "#10243B",
      "border": "#1D4564",
      "cyan": "#16D8ED",
      "cyanSoft": "#57E9F0",
      "electricBlue": "#008DFF",
      "white": "#F5F8FD",
      "muted": "#B9C9DA",
      "mutedDim": "#849BB1",
      "positive": "#2AD9A0",
      "warning": "#F0B84A",
      "danger": "#FF6E78"
    },
    "gradient": {
      "brand": "linear-gradient(110deg,#3BE9EF 0%,#008BFF 100%)",
      "dark": "linear-gradient(135deg,#040C18 0%,#061C34 100%)",
      "heroOverlay": "linear-gradient(90deg,rgba(2,10,22,.96),rgba(2,10,22,.55) 62%,rgba(2,10,22,.15))"
    },
    "fonts": {
      "primary": "Inter, Arial, Helvetica, sans-serif",
      "bodyWeight": 400,
      "medium": 600,
      "headingWeight": 800,
      "displayLetterSpacing": "-0.045em",
      "bodyLineHeight": 1.55,
      "captionLetterSpacing": "0.12em"
    },
    "typeScale": {
      "xs": 12,
      "sm": 14,
      "body": 16,
      "lead": 20,
      "h3": 24,
      "h2": 40,
      "h1": 64,
      "hero": 82
    },
    "spacing": {
      "unit": 4,
      "scale": [
        0,
        4,
        8,
        12,
        16,
        20,
        24,
        32,
        40,
        48,
        64,
        80,
        96
      ]
    },
    "radii": {
      "sm": 8,
      "md": 12,
      "lg": 18,
      "xl": 24,
      "pill": 9999
    },
    "shadow": {
      "card": "0 12px 40px rgba(0,5,18,.2)",
      "glow": "0 0 28px rgba(22,216,237,.17)"
    },
    "borders": {
      "default": "1px solid #1D4564",
      "focus": "3px solid #57E9F0"
    },
    "breakpoints": {
      "mobile": 390,
      "tablet": 768,
      "laptop": 1024,
      "desktop": 1440,
      "wide": 1680
    }
  },
  "components": {
    "navbar": {
      "desktopHeight": 84,
      "mobileHeight": 66,
      "sticky": true,
      "blur": 14
    },
    "button": {
      "primary": "cyan gradient, dark text, min-height 48",
      "secondary": "transparent border cyan, white text",
      "disabled": "visible disabled state with reason"
    },
    "cards": {
      "surface": "#09192D",
      "radius": 12,
      "border": "#1D4564"
    },
    "appShell": {
      "sidebarDesktop": 250,
      "sidebarCollapsed": 76,
      "header": 72,
      "contentMaxWidth": 1440
    },
    "dataTables": {
      "minRowHeight": 48,
      "stickyHeader": true,
      "sortControlled": true,
      "emptyState": true
    },
    "feedback": {
      "loading": true,
      "error": true,
      "empty": true,
      "permissionDenied": true,
      "timeout": true
    }
  },
  "motion": {
    "duration": {
      "fast": 120,
      "regular": 240,
      "slow": 600
    },
    "particles": "Only marketing hero, very subtle; never block text",
    "parallax": "desktop marketing only",
    "reducedMotion": "disable parallax and particle animation; preserve instant access"
  },
  "accessibility": {
    "contrastTarget": "WCAG 2.2 AA",
    "keyboard": true,
    "visibleFocus": true,
    "labelsAndAlt": true,
    "language": "pt-BR",
    "forms": "error and success status accessible",
    "responsive": "must not depend on hover"
  },
  "logoPolicy": {
    "sourceAsset": "assets/brand/Logo_Oficial_AtlasHub.png",
    "mustBeExact": true,
    "neverExtractFromMockup": true,
    "maintainSafeArea": "at least 0.5x symbol height",
    "doNotBakeIntoHero": true
  }
}
